# Copy to .env for local development.

# Local Postgres from docker-compose.yml. Port 5433 to avoid colliding with a
# Postgres already running on the machine.
DATABASE_URL=postgres://tew:tew@localhost:5433/tew

PORT=8080
HOST=0.0.0.0

# Firebase Admin credentials. Leave unset for now — STATE.md defers the
# Firebase project, and the stub verifier covers development.
#
# Setting these currently makes the server refuse to start, on purpose:
# FirebaseTokenVerifier is not implemented yet, and silently ignoring real
# credentials would be worse than failing loudly.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
