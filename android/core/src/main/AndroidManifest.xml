<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Declared here rather than in :app because :core is the only module that
        opens a socket — it owns both the API client and Media3 playback, and a
        feature module reaching the network directly is a boundary violation
        (IMPLEMENTATION.md). Manifest merging carries it up to :app.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Used to tell "offline" apart from "the server is unwell", so the app can
        say which one out loud. A screen-reader user gets no signal-strength
        icon to glance at, so a wrong guess here is a dead end rather than a
        minor inaccuracy.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Voice control (non-negotiable #5's voice route) and recording a memo.
        The microphone is opened only while the user is actively speaking a
        command or recording — never continuously. Non-negotiable #7 treats
        voice as biometric data, and an always-listening mic in an app whose
        users are disproportionately at home and alone would capture a private
        space rather than a command.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

</manifest>
